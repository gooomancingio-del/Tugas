<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Aritmetika JavaScript</title>
</head>
<body>

<h2>Aritmetika JavaScript</h2>

<input type="number" id="angka1" placeholder="Angka 1">
<input type="number" id="angka2" placeholder="Angka 2">
<br><br>

<button onclick="tambah()">+</button>
<button onclick="kurang()">-</button>
<button onclick="kali()">×</button>
<button onclick="bagi()">÷</button>

<h3>Hasil: <span id="hasil">0</span></h3>

<script>
function tambah() {
    hasil(angka1.valueAsNumber + angka2.valueAsNumber);
}

function kurang() {
    hasil(angka1.valueAsNumber - angka2.valueAsNumber);
}

function kali() {
    hasil(angka1.valueAsNumber * angka2.valueAsNumber);
}

function bagi() {
    hasil(angka1.valueAsNumber / angka2.valueAsNumber);
}

function hasil(nilai) {
    document.getElementById("hasil").innerText = nilai;
}
</script>

</body>
</html>
